<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Local developer paths. Tracked but keep personal edits out of commits
    via: echo VPB.local.props >> .git/info/exclude
  -->
  <PropertyGroup>
    <VaMPath>/home/pc/Documents/Games/VAM</VaMPath>
    <!-- Linux/Mono: Rider + msbuild need reference assemblies for net35 (MSB3644). -->
    <FrameworkPathOverride Condition="Exists('/usr/lib/mono/2.0-api/mscorlib.dll')">/usr/lib/mono/2.0-api</FrameworkPathOverride>
  </PropertyGroup>
</Project>
