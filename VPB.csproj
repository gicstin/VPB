  <!--
    plugin_version.txt: line 1 = base (e.g. 0.28.0 or v0.28.0), line 2 = next build counter (integer).
    Before each compile: if line 1 changed vs last build (see obj/VPB_last_plugin_base.txt), line 2 resets to 1;
    then PluginVersion.g.cs is written for this build, and line 2 is bumped for the next compile.
    Set SkipVPBVersionPrepare=true to skip (e.g. some CI). Design-time builds are skipped.
  -->
  <Target Name="GeneratePluginVersion" BeforeTargets="BeforeCompile" Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipVPBVersionPrepare)' != 'true'">
    <!-- Trim trailing \ so cmd.exe does not treat \" inside -IntermediateDir "...\Debug\" as an escaped quote (which drops -ProjectDir). -->
    <PropertyGroup>
      <_PVFullInt>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)'))</_PVFullInt>
      <PluginVersionIntermediateDir>$([System.String]::Copy('$(_PVFullInt)').TrimEnd('\'))</PluginVersionIntermediateDir>
      <_PVProjDir>$([System.String]::Copy('$(MSBuildProjectDirectory)').TrimEnd('\'))</_PVProjDir>
    </PropertyGroup>
    <MakeDir Directories="$(PluginVersionIntermediateDir)" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_PVProjDir)\scripts\PreparePluginVersion.ps1&quot; -VersionFile &quot;$(_PVProjDir)\plugin_version.txt&quot; -IntermediateDir &quot;$(PluginVersionIntermediateDir)&quot; -ProjectDir &quot;$(_PVProjDir)&quot;" WorkingDirectory="$(_PVProjDir)" />
  </Target>
  <!--
    Keeps vam_patch/patch_manifest.json vpb_icons rows in sync with vam_patch/BepInEx/plugins/vpb_icons on disk.
    Set SkipVPBPatchManifestSync=true to skip (e.g. CI). Design-time builds are skipped.
  -->
  <Target Name="SyncPatchManifestVpbIcons" BeforeTargets="BeforeCompile" Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipVPBPatchManifestSync)' != 'true'">
    <PropertyGroup>
      <_SMProjDir>$([System.String]::Copy('$(MSBuildProjectDirectory)').TrimEnd('\'))</_SMProjDir>
    </PropertyGroup>
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(_SMProjDir)\scripts\SyncPatchManifestVpbIcons.ps1&quot; -ProjectDir &quot;$(_SMProjDir)&quot;" WorkingDirectory="$(_SMProjDir)" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <PropertyGroup>
    <!-- DLL + vpb_translations + vpb_fonts + vpb_icons: same PostBuildEvent so copies always run with the DLL (AfterTargets=PostBuildEvent is unreliable across MSBuild/VS). Robocopy: exit 0-7 = success. -->
    <PostBuildEvent>copy /Y "$(TargetPath)" "$(VaMPath)\BepInEx\plugins\VPB.dll"
copy /Y "$(TargetPath)" "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\VPB.dll"
if exist "$(VaMPath)\BepInEx\scripts\sqlite3.dll" del /F /Q "$(VaMPath)\BepInEx\scripts\sqlite3.dll"
if exist "$(MSBuildProjectDirectory)\lib\sqlite-native\sqlite3.dll" (
if not exist "$(VaMPath)\BepInEx\plugins" mkdir "$(VaMPath)\BepInEx\plugins"
copy /Y "$(MSBuildProjectDirectory)\lib\sqlite-native\sqlite3.dll" "$(VaMPath)\BepInEx\plugins\sqlite3.dll"
if not exist "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins" mkdir "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins"
copy /Y "$(MSBuildProjectDirectory)\lib\sqlite-native\sqlite3.dll" "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\sqlite3.dll"
)
if exist "$(MSBuildProjectDirectory)\lib\turbojpeg\turbojpeg.dll" (
if not exist "$(VaMPath)\BepInEx\plugins" mkdir "$(VaMPath)\BepInEx\plugins"
copy /Y "$(MSBuildProjectDirectory)\lib\turbojpeg\turbojpeg.dll" "$(VaMPath)\BepInEx\plugins\turbojpeg.dll"
if not exist "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins" mkdir "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins"
copy /Y "$(MSBuildProjectDirectory)\lib\turbojpeg\turbojpeg.dll" "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\turbojpeg.dll"
)
if not exist "$(MSBuildProjectDirectory)\lib\turbojpeg\turbojpeg.dll" (
if exist "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\turbojpeg.dll" (
if not exist "$(VaMPath)\BepInEx\plugins" mkdir "$(VaMPath)\BepInEx\plugins"
if not exist "$(VaMPath)\BepInEx\plugins\turbojpeg.dll" copy /Y "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\turbojpeg.dll" "$(VaMPath)\BepInEx\plugins\turbojpeg.dll"
)
)
if exist "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\vpb_translations\" (
robocopy "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\vpb_translations" "$(VaMPath)\BepInEx\plugins\vpb_translations" /E /NFL /NDL /NJH /NJS /NC /NS /NP
if errorlevel 8 exit 1
robocopy "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\vpb_translations" "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\vpb_translations" /E /NFL /NDL /NJH /NJS /NC /NS /NP
if errorlevel 8 exit 1
)
if exist "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\vpb_fonts\" (
