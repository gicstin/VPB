if errorlevel 8 exit 1
robocopy "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\vpb_icons" "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\vpb_icons" /E /NFL /NDL /NJH /NJS /NC /NS /NP
if errorlevel 8 exit 1
)</PostBuildEvent>
