if errorlevel 8 exit 1
robocopy "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\vpb_fonts" "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\vpb_fonts" /E /NFL /NDL /NJH /NJS /NC /NS /NP
if errorlevel 8 exit 1
)
if exist "$(MSBuildProjectDirectory)\vam_patch\BepInEx\plugins\vpb_icons\" (
