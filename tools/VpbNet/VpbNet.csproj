<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>VpbNet</AssemblyName>
    <RootNamespace>VpbNet</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>false</PublishTrimmed>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.5.0</Version>
    <AssemblyVersion>0.5.0.0</AssemblyVersion>
    <Description>VPB multiplayer broker. Launched by the VPB plugin; not intended to be run by hand.</Description>
  </PropertyGroup>

  <!--
    The protocol lives in /protocol and belongs to neither side. Both processes must agree
    bit-for-bit on the wire layout, clock math, jitter buffer, codecs, session machine and
    diagnostics text, and no assembly reference can span .NET 3.5 Mono in VaM and .NET 8 here,
    so the same source is compiled twice. VPB.csproj lists these files by hand as well.

    Link keeps them in a Shared folder in the IDE, where they were before, so a stack trace and
    a project tree still read the way the code does.
  -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\..\protocol\*.cs"
             Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
